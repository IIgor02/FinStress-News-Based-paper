data/processed/*.csv
data/processed/*.json
!data/raw/.gitkeep
!data/processed/.gitkeep

# Output files (regenerated on run)
output/results/*.csv
output/results/*.json
output/plots/*.png
output/plots/*.jpg
output/plots/*.pdf
!output/results/.gitkeep
!output/plots/.gitkeep

